{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".scripts-dist",
    "rootDir": "."
  },
  "include": ["lib/**/*.ts", "scripts/**/*.ts"]
}
